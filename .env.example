# Required: Supabase PostgreSQL connection string. For Render, prefer Supabase Session Pooler (IPv4-compatible).
# Copy it from Supabase Dashboard > Connect > Session pooler. Keep sslmode=require.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_SSL=true

# Required: generate a long random secret, never share it or commit it publicly
ADMIN_TOKEN=replace-with-a-long-random-secret-at-least-24-characters

# Optional email notifications (for Gmail, use a Google App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mindacademy540@gmail.com
SMTP_PASS=your-google-app-password
MAIL_FROM=mindacademy540@gmail.com
NOTIFY_EMAIL=mindacademy540@gmail.com
